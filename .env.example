# ─────────────────────────────────────────────────────────────────────────────
# GPT Checker — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit your actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (provisioned by Replit)
DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT secret for admin sessions — generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# Port for the API server
PORT=8080

# Node environment
NODE_ENV=development

# ─── Admin seed ───────────────────────────────────────────────────────────────
# Used by scripts/seed-admin.ts to create the first admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Bot token from @BotFather (also stored in DB settings, this is a fallback)
TELEGRAM_BOT_TOKEN=

# ─── Optional ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
